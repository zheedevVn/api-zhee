{
  "version": 2,
  "functions": {
    "api/server.js": {
      "includeFiles": "{lib/**,public/**}",
      "regions": ["sin1"],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/server.js"
    }
  ]
}